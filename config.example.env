# Hysteria Checker - Configuration Reference
# Copy this file to .env and adjust values as needed.
# All options can also be passed as CLI flags (see README.md).

# ── Subscription ─────────────────────────────────────────────
# Subscription URLs or direct hysteria:// / hysteria2:// / hy2:// links.
# Comma-separated or repeated.
SUBSCRIPTION_URL=https://example.com/subscription

# ── Check Settings ───────────────────────────────────────────
# Interval between health checks. (default: 300s)
#CHECK_INTERVAL=300s

# Check method: ip or status. (default: ip)
#CHECK_METHOD=ip

# URL used for IP-based or status-based check. (default: https://api.ipify.org)
#CHECK_URL=https://api.ipify.org

# Timeout for each proxy check. (default: 30s)
#CHECK_TIMEOUT=30s

# ── Metrics / Web Server ────────────────────────────────────
# Host to bind the metrics/web server. (default: 0.0.0.0)
#METRICS_HOST=0.0.0.0

# Port for the metrics/web server. (default: 2112)
#METRICS_PORT=2112

# If true, hide sensitive details on the dashboard for unauthenticated users. (default: false)
#WEB_PUBLIC=false

# ── Authentication ───────────────────────────────────────────
# Enable Basic Auth for metrics. (default: false)
#METRICS_PROTECTED=false

# Basic Auth username for metrics. (required if METRICS_PROTECTED=true)
#METRICS_USERNAME=

# Basic Auth password for metrics. (required if METRICS_PROTECTED=true)
#METRICS_PASSWORD=

# ── Logging ──────────────────────────────────────────────────
# Log level: debug, info, warn, error. (default: info)
#LOG_LEVEL=info
